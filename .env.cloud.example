# Copy to .env.cloud.local; these two values are public, protected by RLS.
VITE_DIALED_MODE=cloud
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
# Configure these separately as Cloudflare Pages runtime secrets:
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, DIALED_WORKSPACE_ID
# Never put the service-role key in a VITE_ variable.
